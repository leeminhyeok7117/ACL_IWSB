# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: cubesat_TX_IWSB
label: cubesat_TX_IWSB
description: The Sink example is the counterpart of the Sensor example. It receives
  reports of Sensor nodes joining to its network.
category: Connect Examples
filter:
- name: Device Type
  value: [SoC]
- name: Project Difficulty
  value: [Beginner]
- name: Wireless Technology
  value: [Connect]
package: Flex
quality: production
readme:
- {path: readme.md}
- {path: readme.md}
source:
- {path: main.c}
- {path: app_init.c}
- {path: app_process.c}
- {path: app_cli.c}
- {path: iq_capture.c}
include:
- path: .
  file_list:
  - {path: app_init.h}
  - {path: app_process.h}
  - {path: iq_capture.h}
sdk: {id: gecko_sdk, version: 4.5.0}
toolchain_settings:
- {value: debug, option: optimize}
component:
- {id: EFR32FG12P433F1024GL125}
- {id: app_assert}
- {id: app_log}
- {id: bootloader_interface}
- {id: brd4002a}
- {id: brd4253a}
- instance: [example]
  id: cli
- {id: connect_aes_security}
- {id: connect_app_framework_common}
- {id: connect_debug_print}
- {id: connect_frequency_hopping}
- {id: connect_mac_queue}
- {id: connect_ota_unicast_bootloader_server}
- {id: connect_parent_support}
- {id: connect_poll}
- {id: connect_stack_common}
- {id: connect_stack_counters}
- {id: device_init}
- {id: dmadrv}
- {id: emlib_i2c}
- {id: iostream_retarget_stdio}
- {id: iostream_rtt}
- {id: mpu}
- {id: nvm3_default}
- {id: printf}
- {id: psa_its}
- {id: radio_config_simple_connect_singlephy}
- {id: rail_util_pti}
- {id: restrictions_profile_connect}
- {id: restrictions_profile_connect_ofdm}
- {id: restrictions_profile_long_range}
- instance: [btn0]
  id: simple_button
- instance: [led0]
  id: simple_led
- {id: sl_connect_config}
- {id: sl_sensor_sink_core}
- {id: sl_system}
- {id: token_manager}
other_file:
- {path: connect_create_gbl_image.bat}
- {path: connect_create_gbl_image.sh}
define:
- {name: SINK_ROLE, value: '1'}
- {name: SL_CONNECT_DISABLE_WATCHDOG}
template_contribution:
- name: cli_command
  priority: 0
  value: {name: info, handler: cli_info, help: 'MCU ID, Network state, Node ID, PAN
      ID, Channel ID, etc.'}
- name: cli_command
  priority: 0
  value: {name: reset, handler: cli_reset, help: Reset the hardware}
- name: cli_command
  priority: 0
  value:
    name: counter
    handler: cli_counter
    help: Print out the passed stack counter
    argument:
    - {type: uint8, help: Counter type}
- name: cli_command
  priority: 0
  value:
    name: set_channel
    handler: cli_set_channel
    help: Set Connect channel
    argument:
    - {type: uint8, help: Channel ID}
- name: cli_command
  priority: 0
  value: {name: leave, handler: cli_leave, help: Forget the current network and revert
      to EMBER_NO_NETWORK}
- name: cli_command
  priority: 0
  value:
    name: set_tx_options
    handler: cli_set_tx_option
    help: Set Tx options
    argument:
    - {type: uint8, help: Security(0x01) MAC Ack(0x02) High Prio(0x04)}
- name: cli_command
  priority: 0
  value:
    name: start_energy_scan
    handler: cli_start_energy_scan
    help: Scan the energy level on the given channel
    argument:
    - {type: uint8, help: Channel ID}
    - {type: uint8, help: Number of samples}
- name: cli_command
  priority: 0
  value:
    name: set_key
    handler: cli_set_security_key
    help: Set security key
    argument:
    - {type: hex, help: 'Security key (size:EMBER_ENCRYPTION_KEY_SIZE)'}
- name: cli_command
  priority: 0
  value: {name: unset_key, handler: cli_unset_security_key, help: Unset current security
      key}
- name: cli_command
  priority: 0
  value:
    name: form
    handler: cli_form
    help: Forms a network
    argument:
    - {type: uint8, help: Channel}
    - {type: uint16opt, help: Optional PAN ID}
- name: cli_command
  priority: 0
  value:
    name: set_tx_power
    handler: cli_set_tx_power
    help: Sets the antenna output power. The second optional parameter can be used
      to save the TX power as default
    argument:
    - {type: int16, help: TX power value in 0.1 dBm steps}
    - {type: uint8opt, help: '1 - TX power persistent (saved in token), 0 - TX power
        volatile'}
- name: cli_command
  priority: 0
  value:
    name: pjoin
    handler: cli_pjoin
    help: Permit join for a given time period with optional selective payload
    argument:
    - {type: uint8, help: Duration}
    - {type: stringopt, help: Optional Join payload}
- name: cli_command
  priority: 0
  value:
    name: remove_child
    handler: cli_remove_child
    help: Remove a specific sensor child from the list
    argument:
    - {type: uint8, help: Mode}
    - {type: uint16, help: Short Address of the child to remove. Not used if long
        address is given}
    - {type: hexopt, help: Long Address of the child to remove}
- name: cli_command
  priority: 0
  value: {name: meas, handler: cli_meas_start, help: Start one RSSI measurement campaign
      (frequency-hopping sweep)}
- name: cli_command
  priority: 0
  value: {name: meas_stat, handler: cli_meas_stat, help: Print RSSI log status/record
      count}
- name: cli_command
  priority: 0
  value: {name: meas_clear, handler: cli_meas_clear, help: Clear the RSSI log (reset
      cursor)}
- name: cli_command
  priority: 0
  value:
    name: meas_auto
    handler: cli_meas_auto
    help: Enable/disable periodic auto sweep (arg 0/1; no arg = show state)
    argument:
    - {type: uint8opt, help: '1=enable periodic sweep, 0=disable'}
- name: cli_command
  priority: 0
  value:
    name: ota_target
    handler: cli_ota_target
    help: Select OTA target device_id (1-4)
    argument:
    - {type: uint8, help: device_id}
- name: cli_command
  priority: 0
  value:
    name: ota_start
    handler: cli_ota_start
    help: '[TEST-ONLY] Start OTA to device_id without I2C'
    argument:
    - {type: uint8, help: device_id}
- name: cli_command
  priority: 0
  value: {name: slave_list, handler: cli_slave_list, help: Print registered slave
      list}
- name: cli_command
  priority: 0
  value: {name: poll_status, handler: cli_poll_status, help: Force restart polling
      cycle}
- name: cli_command
  priority: 0
  value:
    name: iq_start
    handler: cli_iq_start
    help: '[IQ ground test] Open IQ measurement window for dur_s seconds (replaces
      OBC 0x05)'
    argument:
    - {type: uint16opt, help: Duration in seconds (default 5)}
- name: cli_command
  priority: 0
  value:
    name: iq_auto
    handler: cli_iq_auto
    help: '[IWSB ground test] Auto-drain batches (0/1; no arg = show state)'
    argument:
    - {type: uint8opt, help: '1=auto-drain ON, 0=OFF'}
- name: cli_command
  priority: 0
  value: {name: spi_stat, handler: cli_spi_stat, help: '[ground test] SPI slave diagnostics'}
- name: cli_command
  priority: 0
  value: {name: spi_clear, handler: cli_spi_clear, help: '[ground test] Clear SPI
      diagnostic counters'}
- name: cli_command
  priority: 0
  value:
    name: spi_inject
    handler: cli_spi_inject
    help: '[ground test] Inject an OBC command without physical SPI'
    argument:
    - {type: uint8, help: Command byte}
    - {type: uint8opt, help: Optional argument byte}
- name: cli_command
  priority: 0
  value: {name: iq_abort, handler: cli_iq_abort, help: '[IWSB ground test] Abort running
      mission'}
- name: cli_command
  priority: 0
  value: {name: iq_status, handler: cli_iq_status, help: '[IQ ground test] Print queued
      IQ record count'}
- name: cli_command
  priority: 0
  value: {name: iq_dump, handler: cli_iq_dump, help: '[IQ ground test] Dump all queued
      IQ records as CSV over UART (replaces OBC 0x06)'}
requires:
- {name: a_radio_config}
configuration:
- {name: SL_BOARD_ENABLE_VCOM, value: '1'}
- {name: SL_CLI_LOCAL_ECHO, value: (1)}
- {name: SL_IOSTREAM_USART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF, value: (1)}
- {name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE, value: usartHwFlowControlNone}
- {name: SL_IOSTREAM_EUSART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF, value: (1)}
- {name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE, value: eusartHwFlowControlNone}
- {name: APP_LOG_PREFIX_ENABLE, value: '0'}
- {name: SL_STACK_SIZE, value: '8192'}
- {name: SL_HEAP_SIZE, value: '10240'}
ui_hints:
  highlight:
  - {path: readme.md, focus: true}

