#include "em_i2c.h"
#include "app_log.h"
#include "rail.h"
#include "sl_rail_util_init.h"

#define CC_TX_BURST       0x04   // 이 cc 값에서 버스트 시작
#define TX_TOTAL_PKTS     1000
#define TX_PAYLOAD_LEN    16     // Radio Configurator 고정 길이와 일치
#define TX_PAYLOAD_VALUE  0x00   // 1000개 모두 이 값. 4로 바꾸려면 0x04
#define TX_CHANNEL        0

#define I2C_SLAVE_ADDRESS  (0x50 << 1)   // SDRC가 거는 7bit 주소<<1
#define I2C_BUFFER_SIZE    256           // rx_buffer 크기


static uint8_t  rx_buffer[I2C_BUFFER_SIZE];
static volatile uint16_t rx_len = 0;
static volatile bool data_ready = false;

static uint8_t  tx_payload[TX_PAYLOAD_LEN];   // app_init에서 채워도 되고 여기서
static volatile bool     tx_active    = false;
static volatile bool     send_next    = false;
static volatile bool     burst_done   = false;
static volatile uint16_t packets_sent = 0;

// ---- I2C 수신 (SDRC가 SDR에 write) ----
void I2C0_IRQHandler(void)
{
    uint32_t pending = I2C0->IF;

    if (pending & I2C_IF_ADDR) {
        (void)I2C0->RXDATA;            // 주소 바이트 소거
        rx_len = 0;
        I2C_IntClear(I2C0, I2C_IFC_ADDR);
        I2C0->CMD = I2C_CMD_ACK;
        return;
    }

    if (pending & I2C_IF_RXDATAV) {
        if (rx_len < sizeof(rx_buffer)) {
            rx_buffer[rx_len++] = I2C0->RXDATA;
        } else {
            (void)I2C0->RXDATA;
        }
        I2C0->CMD = I2C_CMD_ACK;
    }

    if (pending & I2C_IF_SSTOP) {
        I2C_IntClear(I2C0, I2C_IFC_SSTOP);
        data_ready = true;
    }
}

// ---- 메인 로직 ----
void app_process_action(RAIL_Handle_t rail_handle)
{
    // 1) I2C 명령 처리
    if (data_ready) {
        data_ready = false;
        uint8_t cc = rx_buffer[0];
        app_log_info("cc = %02X\r\n", cc);

        switch (cc) {
            case CC_TX_BURST:                       // == 4
                if (!tx_active) {
                    for (uint16_t i = 0; i < TX_PAYLOAD_LEN; i++)
                        tx_payload[i] = TX_PAYLOAD_VALUE;
                    tx_active    = true;
                    packets_sent = 0;
                    send_next    = true;            // 첫 패킷 트리거
                    app_log_info("TX burst start (%d pkts)\r\n", TX_TOTAL_PKTS);
                }
                break;
            default:
                app_log_info("Unknown cc\r\n");
                break;
        }
    }

    // 2) RAIL 버스트 (완료 이벤트로 페이싱 → FIFO 오버런 없음)
    if (tx_active && send_next && packets_sent < TX_TOTAL_PKTS) {
        send_next = false;
        RAIL_WriteTxFifo(rail_handle, tx_payload, TX_PAYLOAD_LEN, true);
        RAIL_Status_t st = RAIL_StartTx(rail_handle, TX_CHANNEL,
                                        RAIL_TX_OPTIONS_DEFAULT, NULL);
        if (st != RAIL_STATUS_NO_ERROR) {
            send_next = true;                       // 즉시 재시도
        }
    }

    // 3) 완료 로그 (인터럽트 밖에서)
    if (burst_done) {
        burst_done = false;
        app_log_info("=== TX burst done: %u pkts ===\r\n", (unsigned)packets_sent);
    }
}

// ---- RAIL 송신 완료/실패 콜백 (인터럽트 컨텍스트: 플래그만!) ----
void sl_rail_util_on_event(RAIL_Handle_t rail_handle, RAIL_Events_t events)
{
    (void)rail_handle;

    if (events & RAIL_EVENT_TX_PACKET_SENT) {
        packets_sent++;
        if (packets_sent >= TX_TOTAL_PKTS) {
            tx_active  = false;
            burst_done = true;
        } else {
            send_next = true;
        }
    }
    if (events & (RAIL_EVENT_TX_ABORTED | RAIL_EVENT_TX_BLOCKED
                | RAIL_EVENT_TX_UNDERFLOW | RAIL_EVENT_TX_CHANNEL_BUSY)) {
        send_next = true;                           // 같은 패킷 재시도
    }
}
