#include "sl_rail_util_init.h"
#include "em_i2c.h"
#include "em_cmu.h"
#include "em_gpio.h"
#include "app_log.h"
#include "sl_board_control.h"
#include "rail.h"

#define TX_FIFO_SIZE   64   // 2의 거듭제곱(64~4096)

#define I2C_SLAVE_ADDRESS  (0x50 << 1)   // SDRC가 거는 7bit 주소<<1
#define I2C_BUFFER_SIZE    256           // rx_buffer 크기

// 4바이트 정렬 FIFO (Series 1 필수)
static SL_ALIGN(RAIL_FIFO_ALIGNMENT)
  uint8_t tx_fifo[TX_FIFO_SIZE] SL_ATTRIBUTE_ALIGN(RAIL_FIFO_ALIGNMENT);

RAIL_Handle_t app_init(void)
{
    RAIL_Handle_t rail_handle =
        sl_rail_util_get_handle(SL_RAIL_UTIL_HANDLE_INST0);

    sl_board_enable_vcom();

    CMU_ClockEnable(cmuClock_GPIO, true);
    CMU_ClockEnable(cmuClock_I2C0, true);

    GPIO_PinModeSet(gpioPortC, 10, gpioModeWiredAndPullUpFilter, 1); // SDA
    GPIO_PinModeSet(gpioPortC, 11, gpioModeWiredAndPullUpFilter, 1); // SCL

    I2C0->ROUTEPEN  = I2C_ROUTEPEN_SDAPEN | I2C_ROUTEPEN_SCLPEN;
    I2C0->ROUTELOC0 = (I2C0->ROUTELOC0 & (~_I2C_ROUTELOC0_SDALOC_MASK))
                    | I2C_ROUTELOC0_SDALOC_LOC16;
    I2C0->ROUTELOC0 = (I2C0->ROUTELOC0 & (~_I2C_ROUTELOC0_SCLLOC_MASK))
                    | I2C_ROUTELOC0_SCLLOC_LOC14;

    I2C_Init_TypeDef i2cInit = I2C_INIT_DEFAULT;
    i2cInit.master = false;
    i2cInit.freq   = I2C_FREQ_STANDARD_MAX;
    I2C_Init(I2C0, &i2cInit);

    I2C0->SADDR     = I2C_SLAVE_ADDRESS;   // SDRC가 쓰는 주소와 일치 (SADDR = 7bit<<1)
    I2C0->SADDRMASK = 0xFE;
    I2C0->CTRL     |= I2C_CTRL_SLAVE | I2C_CTRL_AUTOSN;

    // 수신 전용: ADDR / RXDATAV / SSTOP 만 (TXBL·NACK 불필요)
    I2C_IntClear(I2C0,  I2C_IFC_ADDR | I2C_IF_RXDATAV | I2C_IFC_SSTOP);
    I2C_IntEnable(I2C0, I2C_IEN_ADDR | I2C_IEN_RXDATAV | I2C_IEN_SSTOP);
    NVIC_EnableIRQ(I2C0_IRQn);

    // RAIL 송신 FIFO 등록 (간접 방식)
    RAIL_SetTxFifo(rail_handle, tx_fifo, 0, TX_FIFO_SIZE);

    app_log_info("SDR Init Done\r\n");
    return rail_handle;
}
